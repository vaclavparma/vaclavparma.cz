<div id="stars-container"></div>

<style is:global>
  #stars-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
  }

  .star {
    position: absolute;
  }

  .small-star {
    background: #ffffffb0;
    width: 1px;
    height: 1px;
  }

  .medium-star {
    background: #ffffff90;
    width: 2px;
    height: 2px;
  }

  .large-star {
    background: #ffffffa0;
    width: 3px;
    height: 3px;
  }
</style>

<script lang="js">
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("stars-container");
    const starCount = Math.round((window.innerWidth * window.innerHeight) ** 0.5 / 2.25);
    const fragment = document.createDocumentFragment();

    for (let i = 0; i < starCount; i++) {
      const size = Math.random() * 3;
      const star = document.createElement("div");

      star.classList.add("star", size < 1 ? "small-star" : size < 2 ? "medium-star" : "large-star");
      star.style.left = `${Math.random() * 100}vw`;
      star.style.top = `${Math.random() * 100}vh`;

      fragment.appendChild(star);
    }

    container.appendChild(fragment);
  });
</script>
