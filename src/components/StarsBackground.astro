<div id="stars-container">
  <div id="small-stars-wrapper"></div>
  <div id="medium-stars-wrapper"></div>
  <div id="large-stars-wrapper"></div>
</div>

<style is:global>
  #stars-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
  }

  #small-stars-wrapper,
  #medium-stars-wrapper,
  #large-stars-wrapper {
    position: absolute;
    width: 100%;
    height: 100%;
    transition: transform 0.3s ease-out;
  }

  .star {
    position: absolute;
  }

  .small-star {
    background: #ffffffb0;
    width: 1px;
    height: 1px;
  }

  .medium-star {
    background: #ffffff90;
    width: 2px;
    height: 2px;
  }

  .large-star {
    background: #ffffffa0;
    width: 3px;
    height: 3px;
  }
</style>

<script lang="js">
  let lastScrollPosition = 0;

  const STAR_TIERS = [
    { key: "small", maxSize: 1, parallax: 0.05 },
    { key: "medium", maxSize: 2, parallax: 0.1 },
    { key: "large", maxSize: Infinity, parallax: 0.2 },
  ];

  const starWrappers = Object.fromEntries(
    STAR_TIERS.map((tier) => [tier.key, document.getElementById(`${tier.key}-stars-wrapper`)])
  );

  function createStar(tier, posX, posY) {
    const star = document.createElement("div");

    star.classList.add("star", `${tier.key}-star`);
    star.style.left = `${posX}vw`;
    star.style.top = `${posY}px`;
    return star;
  }

  function generateStars() {
    const starCount = Math.round((document.body.clientWidth * document.body.scrollHeight) ** 0.5 / 2.25);
    const fragments = Object.fromEntries(STAR_TIERS.map((tier) => [tier.key, document.createDocumentFragment()]));

    for (let i = 0; i < starCount; i++) {
      const size = Math.random() * 3;
      const posX = Math.random() * 100;
      const posY = Math.random() * document.body.scrollHeight;
      const tier = STAR_TIERS.find((t) => size < t.maxSize);

      fragments[tier.key].appendChild(createStar(tier, posX, posY));
    }

    STAR_TIERS.forEach((tier) => starWrappers[tier.key].appendChild(fragments[tier.key]));
  }

  function handleScroll() {
    const scrollPosition = window.scrollY;

    if (Math.abs(scrollPosition - lastScrollPosition) < window.innerHeight / 25) return;
    lastScrollPosition = scrollPosition;

    STAR_TIERS.forEach((tier) => {
      starWrappers[tier.key].style.transform = `translateY(${-scrollPosition * tier.parallax}px)`;
    });
  }

  window.onload = function () {
    generateStars();
    window.addEventListener("scroll", handleScroll, { passive: true });
  };
</script>