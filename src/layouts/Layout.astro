---
import StarsBackground from '../components/StarsBackground.astro';
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="height=device-height, width=device-width, initial-scale=1.0, target-densitydpi=device-dpi" />
		<link rel="icon" href="/favicon.png" />
		<title>Václav Parma</title>
		<meta name="description" content="Václav Parma — student, programmer and maker from Czech Republic." />
		<meta name="author" content="Václav Parma" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<StarsBackground />
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
		max-width: 100vw;
	}

	html {
		font-family: system-ui, sans-serif;
		background-color: #121212;
		color: #e0e0e0;
		overflow-x: hidden;
		touch-action: manipulation;
		overscroll-behavior-y: none;
	}

	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 100vw;
		box-sizing: border-box;
		overflow-x: hidden;
	}

	main {
		flex: 1;
	}

	::selection {
		background: #7871aa;
	}
</style>
